<%# 埋め込んだ scene は最初に表示したときのもの。Turbo が「戻る」でこのページの写しを出すと古い庭に戻るので、写しを取らせない %>
<% turbo_exempts_page_from_cache %>

<%= tag.div class: "scene", data: {
  controller: "scene",
  action: "keydown@window->scene#keydown",
  scene_scene_value: @garden.scene,
  scene_url_value: garden_path(@garden)
} do %>
  <%# 保存に失敗したときだけ出す。次の操作か、ページを離れるときに送り直す %>
  <p class="scene-save-error" data-scene-target="saveError" role="alert" hidden>保存できませんでした</p>

  <%# 右上の操作。下絵では「プレビュー」「仕上がりを見る」、プレビュー中は「最後まで飛ばす」「下絵に戻る」、
      仕上がりでは「もう一度プレビュー」「下絵に戻る」を出す（文言はコントローラが入れる） %>
  <div class="scene-actions">
    <%# レーキが平らな砂を下のレイヤーから順に掻いていく様子を、音と合わせて見る %>
    <button type="button" data-scene-target="previewButton" data-action="scene#startPreview"></button>
    <button type="button" data-scene-target="skipButton" data-action="scene#skipPreview" hidden>最後まで飛ばす</button>
    <%# 掻いた後の仕上がりと下絵を行き来する。アニメーションなしで一気に掻いた結果を見せる %>
    <button type="button" data-scene-target="toggle" data-action="scene#toggleView"></button>
  </div>

  <%# 選んだ図形のレーキを変える。図形を選んでいる間だけ開く %>
  <section class="scene-panel" data-scene-target="panel" hidden>
    <div class="scene-panel-row">
      <span>歯の本数</span>
      <button type="button" data-action="scene#decreaseTines" aria-label="歯を減らす">−</button>
      <output data-scene-target="tines"></output>
      <button type="button" data-action="scene#increaseTines" aria-label="歯を増やす">＋</button>
    </div>
    <label class="scene-panel-row">
      <span>歯の間隔</span>
      <input type="range" data-scene-target="spacing" data-action="input->scene#changeSpacing change->scene#save">
      <output data-scene-target="spacingValue"></output>
    </label>
    <button type="button" class="scene-panel-delete" data-action="scene#deleteShape">削除</button>
  </section>

  <%# つかんで庭の上で離すと、その位置に図形を置く %>
  <footer class="scene-palette" data-scene-target="palette">
    <button type="button" data-kind="straight" data-action="pointerdown->scene#startPlacing">直線</button>
    <button type="button" data-kind="concentric" data-action="pointerdown->scene#startPlacing">同心円</button>
  </footer>
<% end %>
