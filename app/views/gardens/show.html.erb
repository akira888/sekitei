<%# 埋め込んだ scene は最初に表示したときのもの。Turbo が「戻る」でこのページの写しを出すと古い庭に戻るので、写しを取らせない %>
<% turbo_exempts_page_from_cache %>

<%= tag.div class: "scene", data: {
  controller: "scene",
  action: "keydown@window->scene#keydown",
  scene_scene_value: @garden.scene,
  scene_url_value: garden_path(@garden),
  scene_completed_value: @garden.completed?,
  scene_completion_url_value: garden_completion_path(@garden)
} do %>
  <%# 完成した庭の名前。完成前は隠しておき、完成した瞬間にその場で出す %>
  <h1 class="scene-title" data-scene-target="title" <%= "hidden" unless @garden.completed? %>><%= @garden.name %></h1>
  <%# 保存に失敗したときだけ出す。次の操作か、ページを離れるときに送り直す %>
  <p class="scene-save-error" data-scene-target="saveError" role="alert" hidden>保存できませんでした</p>
  <p class="scene-save-error" data-scene-target="completionError" role="alert" hidden>完成できませんでした。もう一度「完成する」から試してください</p>

  <%# 右上の操作。下絵では「プレビュー」「仕上がりを見る」、プレビュー中は「最後まで飛ばす」「下絵に戻る」、
      仕上がりでは「もう一度プレビュー」「下絵に戻る」を出す（文言はコントローラが入れる） %>
  <div class="scene-actions">
    <%# レーキが平らな砂を下のレイヤーから順に掻いていく様子を、音と合わせて見る %>
    <button type="button" data-scene-target="previewButton" data-action="scene#startPreview"></button>
    <button type="button" data-scene-target="skipButton" data-action="scene#skipPreview" hidden>最後まで飛ばす</button>
    <%# 掻いた後の仕上がりと下絵を行き来する。アニメーションなしで一気に掻いた結果を見せる %>
    <button type="button" data-scene-target="toggle" data-action="scene#toggleView"></button>
    <%# 名前を付けて完成させる。仕上がりの画面で角度を選んでから押す。完成した庭は編集できない %>
    <button type="button" data-scene-target="completeButton" data-action="scene#openCompletion" hidden>完成する</button>
    <%# 完成した庭を共有する。編集と鑑賞は同じ URL %>
    <button type="button" data-scene-target="copyButton" data-action="scene#copyUrl" hidden>URL をコピー</button>
  </div>

  <%# 完成させる前に名前を入れる。確定すると、庭ができあがっていく様子を最後まで流してから完成する %>
  <dialog class="scene-completion" data-scene-target="completionDialog">
    <form method="dialog" data-action="submit->scene#confirmCompletion">
      <p>庭に名前を付けて完成させます。完成すると編集できなくなります。</p>
      <label class="scene-completion-name">
        <span>名前</span>
        <input type="text" maxlength="100" size="24" required data-scene-target="completionName">
      </label>
      <p class="scene-completion-note">今の角度が、鑑賞の始まりの視点になります。完成すると、庭ができあがっていく様子が最後まで流れます。</p>
      <div class="scene-completion-actions">
        <button type="button" data-action="scene#cancelCompletion">やめる</button>
        <button type="submit">完成する</button>
      </div>
    </form>
  </dialog>

  <%# 選んだ図形のレーキを変える。図形を選んでいる間だけ開く %>
  <section class="scene-panel" data-scene-target="panel" hidden>
    <div class="scene-panel-row">
      <span>歯の本数</span>
      <button type="button" data-action="scene#decreaseTines" aria-label="歯を減らす">−</button>
      <output data-scene-target="tines"></output>
      <button type="button" data-action="scene#increaseTines" aria-label="歯を増やす">＋</button>
    </div>
    <label class="scene-panel-row">
      <span>歯の間隔</span>
      <input type="range" data-scene-target="spacing" data-action="input->scene#changeSpacing change->scene#save">
      <output data-scene-target="spacingValue"></output>
    </label>
    <%# 波を選んだときだけ出す %>
    <div class="scene-panel-rows" data-scene-target="waveRows" hidden>
      <% { "amplitude" => "振幅", "wavelength" => "波長" }.each do |param, label| %>
        <label class="scene-panel-row">
          <span><%= label %></span>
          <input type="range" data-scene-target="waveParam" data-param="<%= param %>"
                 data-action="input->scene#changeWave change->scene#save">
          <output data-scene-target="waveParamValue" data-param="<%= param %>"></output>
        </label>
      <% end %>
    </div>
    <button type="button" class="scene-panel-delete" data-action="scene#deleteSelected">削除</button>
  </section>

  <%# 選んだ石を変える。石を選んでいる間だけ開く。
      上の窓には、選んだ石を庭の手前から見た姿を WebGL で描く。窓の下の WebGL を透かすので、窓と外枠には背景を付けない %>
  <section class="scene-stone-panel" data-scene-target="stonePanel" hidden>
    <div class="scene-stone-view" data-scene-target="stoneView" aria-hidden="true"></div>
    <div class="scene-panel-body">
      <% { "size" => "大きさ", "tallness" => "背の高さ", "roughness" => "ゴツゴツ", "moss" => "苔" }.each do |param, label| %>
        <label class="scene-panel-row">
          <span><%= label %></span>
          <input type="range" data-scene-target="stoneParam" data-param="<%= param %>"
                 data-action="input->scene#changeStoneParam change->scene#save">
          <output data-scene-target="stoneParamValue" data-param="<%= param %>"></output>
        </label>
      <% end %>
      <%# 大きさなどは保ったまま、凹凸の出方だけを変える（形のくじを引き直す） %>
      <button type="button" data-action="scene#reshapeStone">別の形にする</button>
      <button type="button" class="scene-panel-delete" data-action="scene#deleteSelected">削除</button>
    </div>
  </section>

  <%# つかんで庭の上で離すと、その位置に図形を置く %>
  <footer class="scene-palette" data-scene-target="palette">
    <button type="button" data-kind="straight" data-action="pointerdown->scene#startPlacing">直線</button>
    <button type="button" data-kind="concentric" data-action="pointerdown->scene#startPlacing">同心円</button>
    <button type="button" data-kind="wave" data-action="pointerdown->scene#startPlacing">波</button>
    <button type="button" data-kind="stone" data-action="pointerdown->scene#startPlacing">石</button>
    <%# 運んで置く項目ではなく、庭の外周の砂利の縁を敷く・外す切り替え %>
    <button type="button" class="scene-palette-toggle" data-scene-target="gravelToggle" data-action="scene#toggleGravel">砂利の縁</button>
  </footer>
<% end %>
